# Optional. If unset, enquiries are validated and logged only.
CONTACT_WEBHOOK_URL=

# Canonical origin used for canonicals, sitemap, robots and Open Graph URLs.
# Defaults to https://nodeblix.com. Never set this to localhost or a preview URL in production.
NEXT_PUBLIC_SITE_URL=

# Set to "true" on staging or any non-production deployment to emit noindex and block robots.
# Vercel preview deployments are treated as noindex automatically. Leave unset in production.
NEXT_PUBLIC_SITE_NOINDEX=

# Google Search Console HTML-tag verification token (the content value only, not the whole tag).
GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (format G-XXXXXXXXXX). Leave unset until the privacy policy and consent
# handling have been updated; the tag is not loaded while this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
